# Copy to .env for local development. Never commit .env.
POSTGRES_DB=watercheck
POSTGRES_USER=watercheck
POSTGRES_PASSWORD=change-me-local-only
# Restricted login role the API uses (16+ chars: letters, digits, _-.~+/=).
API_DB_PASSWORD=change-me-local-api-password
# Token signing key (32+ chars) and Fernet key for installation secrets.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
WC_JWT_SECRET=change-me-local-jwt-secret-0123456789abcdef
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WC_SECRET_KEY=ZGV2LW9ubHktc2VjcmV0LWtleS1jaGFuZ2UtbWUtMDA=
WC_ENVIRONMENT=dev
WC_LOG_LEVEL=INFO
# Change if port 80 is already in use on your machine.
HTTP_PORT=80

# Web routing (infra/caddy/). Dev (default): plain HTTP on localhost with the
# Console at /console/ and the Collect preview at /collect/. The production
# VM sets Caddyfile.prod (HTTPS for the two hostnames below).
WC_CADDYFILE=Caddyfile.dev
# Used by Caddyfile.prod only:
# WC_WEB_HOST=watercheck.fieldquire.cooptconnect.app
# WC_API_HOST=api.watercheck.fieldquire.cooptconnect.app
# Object storage for photos (ADR-012)
WC_S3_ACCESS_KEY=watercheck
WC_S3_SECRET_KEY=change-me-local-s3-secret-0123456789
# Notifications (ADR-013). SMS stays off until you add Africa's Talking keys:
# WC_SMS_PROVIDER=africastalking, WC_SMS_USERNAME=sandbox, WC_SMS_API_KEY=...
WC_SMS_WEBHOOK_TOKEN=change-me-sms-webhook-token-0123456789
