# Production Caddyfile. Caddy obtains and renews certificates automatically
# for both hostnames once DNS points to this VM and ports 80/443 are reachable.
watercheck.cooptconnect.app {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /health {
		reverse_proxy api:8000
	}

	# API lives under /api on the same origin as the web Console (plan D-H).
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Map images (tileserver-gl). Cached by browsers for a week.
	handle_path /tiles/* {
		header Cache-Control "public, max-age=604800"
		reverse_proxy tiles:8080
	}

	# Engine files change only with a Flutter or package upgrade: cache them
	# for a day, while the app shell is re-checked on every request.
	@engine path /canvaskit/* /sqlite3.wasm /assets/fonts/* /assets/packages/* /assets/shaders/*
	header @engine Cache-Control "public, max-age=86400"
	root * /srv/console
	try_files {path} /index.html
	file_server
}

api.watercheck.cooptconnect.app {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy api:8000
	}
}
