# Dev Caddyfile: plain HTTP on :80. Staging/prod add the domain (automatic TLS)
# and HSTS in P12.
:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /health {
		reverse_proxy api:8000
	}

	# API lives under /api on the same origin as the web Console (plan D-H).
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Map images (tileserver-gl). Cached by browsers for a week.
	handle_path /tiles/* {
		header Cache-Control "public, max-age=604800"
		reverse_proxy tiles:8080
	}

	redir /console /console/
	# Build with: flutter build web --base-href /console/
	handle_path /console/* {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}

	# Dev-only web preview of the field app (ADR-006). Not shipped:
	# Collect targets Android and Windows. Build: tools/preview.ps1
	redir /collect /collect/
	handle_path /collect/* {
		root * /srv/collect
		try_files {path} /index.html
		file_server
	}

	redir / /console/

	handle {
		respond "Not found" 404
	}
}
